# 복사해서 .env 로 저장한 뒤 값을 채우세요 (.env 는 git에 올리지 않습니다)
POSTGRES_USER=rss
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rss

# H255의 로컬 LLM (Tailscale IP)
LLM_URL=http://100.101.214.67:5001/v1/chat/completions
LLM_TIMEOUT=300

# 텔레그램 봇 (@BotFather 에서 발급, 없으면 비워두면 발송을 건너뜁니다)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 매일 몇 시에 요약을 보낼지 (0-23)
DIGEST_HOUR=8
# RSS 수집 주기(분)
COLLECT_INTERVAL_MIN=60
